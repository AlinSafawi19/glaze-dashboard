# PostgreSQL — matches docker-compose.yml, which maps the container's 5432 to
# 5435 on the host to avoid clashing with a local postgres and the other
# projects' containers.
DATABASE_URL="postgresql://glaze:glaze@localhost:5435/glaze_app"

# Signs the dashboard session cookie. At least 32 chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Seeded owner account. If SEED_OWNER_PASSWORD is blank the seed generates one
# and prints it once.
SEED_OWNER_EMAIL="owner@glaze.store"
SEED_OWNER_NAME="Faten Fakih"
SEED_OWNER_PASSWORD=""

# Storefront API key minted by the seed. Leave blank to have one generated and
# printed once; set it to reuse a known key across resets.
SEED_API_KEY=""

# Origins allowed to call /api/v1 from the browser. Comma separated, no
# trailing slash. "*" allows any origin.
STOREFRONT_ORIGINS="http://localhost:3000"

# Where "Open in dashboard" points in the new-order email.
DASHBOARD_URL="http://localhost:3002"

# Resend — emails the owner when an order lands (https://resend.com).
# Leave RESEND_API_KEY blank to skip the email; the in-dashboard notification
# fires either way. RESEND_FROM must be on a domain verified with Resend.
RESEND_API_KEY=""
RESEND_FROM="Glaze <orders@glaze.store>"
STORE_EMAIL="owner@glaze.store"
